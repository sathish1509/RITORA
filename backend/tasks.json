{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend:install-and-build",
      "type": "shell",
      "command": "npm install && npx prisma generate --schema prisma/schema.prisma && npm run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$tsc"
      ],
      "group": "build"
    },
    {
      "label": "backend:dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
