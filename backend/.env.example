PORT=3001

# 1. Supabase PostgreSQL Database Connection (Required for Prisma)
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 2. Supabase API Keys (Optional - Only if using Supabase Client SDK / Storage / Auth)
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# 3. Application Security & AI Keys
JWT_SECRET="ritora_secret_jwt_key_hackathon_demo_2026"
CORS_ORIGIN="http://localhost:5173,http://localhost:8081,http://localhost:3000,*"
GEMINI_API_KEY="your_gemini_api_key_here"
